import java.util.Scanner;
import java.io.FileInputStream;

class Solution
{
	public static void main(String args[]) throws Exception
	{
		Scanner sc = new Scanner(System.in);
		int T;
		T=sc.nextInt();

		for(int test_case = 1; test_case <= T; test_case++)
		{
            int N = sc.nextInt(); // 배열의 크기
            int[][] arr = new int[N][N]; // 배열
            
            for(int i=0; i<N; i++) {
                for(int j=0; j<N; j++) {
                    arr[i][j] = sc.nextInt(); // 배열 입력
                }
            }
            
            System.out.println("#" + test_case);
            
            for(int k=0; k<N; k++) {
                for(int c=N-1; c>=0; c--) {  // 90도
                        System.out.print(arr[c][k]);
                    }
                    System.out.print(" ");
                    
                    for(int c=N-1; c>=0; c--) { // 180도
                        System.out.print(arr[N-k-1][c]);
                    }
                    System.out.print(" ");
                    
                    for(int c=0; c<N; c++) { // 270도
                        System.out.print(arr[c][N-k-1]);
                    }
                    System.out.println();
                    
                }
            }
	}
}